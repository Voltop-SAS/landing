{
  "name": "frontend-react-clean-arch-scaffolding",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cm": "cz",
    "prepare": "husky install",
    "test": "jest --verbose",
    "tdd": "jest --verbose --watch --onlyChanged"
  },
  "dependencies": {
    "@types/node": "20.2.5",
    "@types/react-dom": "18.2.4",
    "autoprefixer": "10.4.14",
    "eslint": "8.42.0",
    "eslint-config-next": "13.4.4",
    "next": "13.4.4",
    "next-intl": "^2.14.6",
    "postcss": "8.4.24",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.3.2",
    "typescript": "5.1.3"
  },
  "devDependencies": {
    "@testing-library/react": "14.0.0",
    "@types/react": "18.2.9",
    "commitizen": "4.3.0",
    "cz-emoji-conventional": "1.0.1",
    "eslint-plugin-hexagonal-architecture": "1.0.3",
    "husky": "8.0.3",
    "jest": "29.5.0",
    "lint-staged": "13.2.2",
    "prettier": "2.8.8",
    "ts-standard": "12.0.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx,html,css}": [
      "prettier --write",
      "eslint --fix"
