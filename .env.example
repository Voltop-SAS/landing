# ─────────────────────────────────────────────────────────────────────────────
# VOLTOP WEB · variables de entorno
#
# NINGUNA es obligatoria: las dos tienen como defecto el valor de producción,
# así que el proyecto arranca y compila sin crear este archivo. Existen para
# que un despliegue que NO sea producción no se comporte como si lo fuera.
#
# Uso: copiar a `.env.local` (que está en .gitignore) y ajustar.
#   cp .env.example .env.local
#
# NO hay secretos en este proyecto. No hay base de datos, ni API con clave, ni
# backend propio: el formulario B2B se envía por `mailto:` y la analítica se
# carga desde el cliente. Si algún día entra un secreto, va en `.env.local`
# y NUNCA en este archivo ni en el repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Dominio con el que se construyen sitemap, canonical y hreflang.
# Defecto: https://voltop.co
#
# IMPORTANTE en staging y en previsualizaciones: sin esta variable, esas
# páginas le dicen a un buscador que su contenido canónico vive en producción.
NEXT_PUBLIC_SITE_URL=https://voltop.co

# Contenedor de Google Tag Manager.
# Defecto: GTM-WJ5S2LBF (producción)
#
# En staging conviene apuntarlo a un contenedor de pruebas o dejarlo vacío:
# el tráfico de pruebas en la analítica real no se puede deshacer.
NEXT_PUBLIC_GTM_ID=GTM-WJ5S2LBF
